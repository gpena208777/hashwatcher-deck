#!/bin/sh
# Play the share sound on the Deck speaker. The widget host on current firmware does not.
# The slider scales this clip. It does not change the Deck's speaker level.
printf 'Content-Type: application/json\r\n\r\n'
case "$REMOTE_ADDR" in
127.0.0.1|::1) ;;
*)
	printf '{"ok":false}\n'
	exit 0
	;;
esac
vol=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*vol=\([0-9][0-9]*\).*/\1/p')
case "$vol" in
''|*[!0-9]*) vol=100 ;;
esac
if [ "$vol" -gt 100 ]; then
	vol=100
fi
if [ "$vol" -eq 0 ]; then
	printf '{"ok":true}\n'
	exit 0
fi
wav=/mnt/data/hashwatcher/coin.wav
if [ ! -f "$wav" ]; then
	printf '{"ok":false,"error":"sound missing"}\n'
	exit 0
fi
printf '{"ok":true}\n'
trap '' HUP
(
	scale=$(printf '%d.%02d' $((vol / 100)) $((vol % 100)))
	cfg=/tmp/hashwatcher-play-$$.asound
	cat > "$cfg" << EOF
pcm.hwshare {
    type route
    slave.pcm {
        type plug
        slave.pcm {
            type hw
            card 0
            device 0
        }
    }
    ttable.0.0 $scale
    ttable.0.1 $scale
}
EOF
	ALSA_CONFIG_PATH="$cfg" aplay -D hwshare -q "$wav" >/dev/null 2>&1
	rm -f "$cfg"
) >/dev/null 2>&1 &
