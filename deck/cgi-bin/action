#!/bin/sh
# Localhost-only control for the Tailscale supervisor. uhttpd serves this from cgi-bin.
printf 'Content-Type: application/json\r\n\r\n'
cmd=$(printf '%s' "$QUERY_STRING" | sed 's/[^a-z].*//')
case "$cmd" in
stop|start|restart|relogin|reset)
	printf '%s\n' "$cmd" > /mnt/data/tailscale/cmd
	printf '{"ok":true,"cmd":"%s"}\n' "$cmd"
	;;
install)
	printf '{"ok":true,"cmd":"install"}\n'
	trap '' HUP
	if [ -x /mnt/data/hashwatcher/install-tailscale.sh ]; then
		/mnt/data/hashwatcher/install-tailscale.sh >>/mnt/data/hashwatcher/install-tailscale.log 2>&1 &
	else
		printf '%s\n' start > /mnt/data/tailscale/cmd
	fi
	;;
update)
	# HashWatcher software update. Tailscale does not have to be installed.
	printf '{"ok":true,"cmd":"update"}\n'
	trap '' HUP
	if [ -x /mnt/data/hashwatcher/update-widget ]; then
		start-stop-daemon -S -b -x /mnt/data/hashwatcher/update-widget || true
	elif [ -x /mnt/data/tailscale/www/cgi-bin/update-widget ]; then
		start-stop-daemon -S -b -x /mnt/data/tailscale/www/cgi-bin/update-widget || true
	fi
	;;
*)
	printf '{"ok":false}\n'
	;;
esac
