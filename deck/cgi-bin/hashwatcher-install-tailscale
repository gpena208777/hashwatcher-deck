#!/bin/sh
# Local installer trigger. Tailscale itself is downloaded only after this runs.
printf 'Content-Type: application/json\r\n\r\n'
case "$REMOTE_ADDR" in
127.0.0.1|::1) ;;
*)
	printf '{"ok":false}\n'
	exit 0
	;;
esac
if [ ! -x /mnt/data/hashwatcher/install-tailscale.sh ]; then
	printf '{"ok":false,"error":"installer missing"}\n'
	exit 0
fi
if [ -d /tmp/hashwatcher-tailscale-install.lock ]; then
	printf '{"ok":true,"cmd":"install"}\n'
	exit 0
fi
mkdir -p /mnt/data/hashwatcher
printf '{"state":"downloading","progress":1,"error":""}\n' > /mnt/data/hashwatcher/install-status.json
printf '{"ok":true,"cmd":"install"}\n'
trap '' HUP
if [ -x /sbin/start-stop-daemon ]; then
	start-stop-daemon -S -b -x /bin/sh -- /mnt/data/hashwatcher/install-tailscale.sh
else
	/mnt/data/hashwatcher/install-tailscale.sh >/dev/null 2>&1 &
fi
